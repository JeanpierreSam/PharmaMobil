-- Usuario y permisos de la última sesión verificada. El token NO va aquí:
-- sigue en el almacén seguro (Keystore / Keychain). Sirve para abrir la app
-- sin red: sin servidor no hay cómo validar el token, pero sí qué mostrar.
CREATE TABLE perfil (
    id       INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    usuario  TEXT    NOT NULL,
    nombre   TEXT    NOT NULL,
    permisos TEXT    NOT NULL
);

guardarPerfil:
INSERT OR REPLACE INTO perfil(id, usuario, nombre, permisos) VALUES (1, ?, ?, ?);

leerPerfil:
SELECT * FROM perfil WHERE id = 1;

borrarPerfil:
DELETE FROM perfil;
