<?xml version="1.0" encoding="utf-8"?>
<!-- PharmaSoft corre en local por HTTP (sin TLS). Android 9+ bloquea el trafico
     sin cifrar: se permite SOLO hacia el PC que lo sirve. El resto exige HTTPS.
       10.0.2.2       el PC visto desde el emulador
       192.168.137.1  el PC con la zona con cobertura movil de Windows (telefonos reales)
     Si pruebas con el router de tu casa, agrega aqui la IP del PC (ipconfig). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.137.1</domain>
    </domain-config>
</network-security-config>
